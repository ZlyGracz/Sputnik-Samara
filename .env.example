# Необязательно: без файла .env всё запустится со значениями по умолчанию.
# Чтобы переопределить: cp .env.example .env и поправьте значения.
# Пароль БД — без спецсимволов (он подставляется в URL подключения).

POSTGRES_DB=sputnik
POSTGRES_USER=sputnik
POSTGRES_PASSWORD=sputnik_dev_password
DB_HOST_PORT=5433

JWT_SECRET=dev-only-change-me
SEED_ON_START=true
